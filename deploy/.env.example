# ===== nongxian-mall 前端部署配置模板 =====
# 复制为同目录的 .env 后填写真实值（.env 已被仓库根 .gitignore 忽略，不会提交）。
# 也可不创建 .env，直接 export 这些变量后运行 deploy_frontend.py。

# 服务器 SSH 地址与账号（必填）
DEPLOY_HOST=204.141.218.37
DEPLOY_USER=root
DEPLOY_PWD=your_server_root_password

# 远端 web 根目录：前端分别部署到 <REMLOY_REMOTE_ROOT>/h5 与 <DEPLOY_REMOTE_ROOT>/admin
DEPLOY_REMOTE_ROOT=/var/www/nongxian-mall

# 解压后修正的文件属主，需与 Nginx / PHP-FPM 运行用户一致
DEPLOY_WWW_OWNER=www-data:www-data
