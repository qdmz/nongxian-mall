# =====================================================================
# 田冲助农商城 - Docker Compose 环境变量
# 复制为 .env.docker 后修改，再执行:
#   docker compose --env-file .env.docker up -d --build
# =====================================================================

# ---------- 数据库 ----------
DB_ROOT_PASSWORD=change-me-root-password
DB_USER=nongxian
DB_PASSWORD=change-me-db-password

# ---------- 应用 ----------
# JWT 签名密钥（务必修改：openssl rand -hex 32）
JWT_SECRET=change-me-jwt-secret
# 首次启动自动重置 admin 密码（留空则保持 SQL 中的默认 admin123456）
ADMIN_PASSWORD=
# 调试模式（生产保持 0）
APP_DEBUG=0

# ---------- 对外端口 ----------
WEB_PORT=8080
